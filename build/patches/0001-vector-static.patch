diff --git a/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c b/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c
index 44dac9e..2d43b34 100644
--- a/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c
+++ b/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c
@@ -5,6 +5,12 @@
 
 #include "fmgr.h"
 
+#if defined(__has_include)
+#  if __has_include("vector_symbols.h")
+#    include "vector_symbols.h"
+#  endif
+#endif
+
 typedef struct dict_entry_s {
     const char *key;
     int value;
@@ -190,6 +196,12 @@ dlsym(void *__restrict handle, const char *__restrict symbol) {
         goto report;
     }
 
+#ifdef PGLITE_STATIC_EXTENSION_SYMBOLS
+    sym = pglite_lookup_extension_symbol(symbol);
+    if (sym)
+        goto report;
+#endif
+
 report:;
     fprintf(stderr, "void *dlsym(void *handle = %p, const char *symbol = %s) => %p\n", handle, symbol, sym);
     return sym;
