diff --git a/pglite-REL_17_4_WASM/build.sh b/pglite-REL_17_4_WASM/build.sh
index b5f9907..32f15d9 100755
--- a/pglite-REL_17_4_WASM/build.sh
+++ b/pglite-REL_17_4_WASM/build.sh
@@ -89,6 +89,24 @@ ________________________________________________________
      -o ${BUILD_PATH}/pglite.o -c ${WORKSPACE}/pglite-wasm/pg_main.c \
      -Wno-incompatible-pointer-types-discards-qualifiers
     then
+        VECTOR_OBJS=""
+        VECTOR_SRC="${PG_EXTRA}/vector"
+        [ -d "${VECTOR_SRC}/src" ] || VECTOR_SRC="${WORKSPACE}/extra/vector"
+        if [ -d "${VECTOR_SRC}/src" ]
+        then
+            mkdir -p "${BUILD_PATH}/vector"
+            for vector_c in "${VECTOR_SRC}"/src/*.c
+            do
+                vector_o="${BUILD_PATH}/vector/$(basename "${vector_c}" .c).o"
+                if ! ${CC} -O2 -fPIC ${CC_PGLITE} ${PGINC} -c "${vector_c}" -o "${vector_o}"
+                then
+                    echo "pgvector compilation failed: ${vector_c}"
+                    exit 22
+                fi
+                VECTOR_OBJS="${VECTOR_OBJS} ${vector_o}"
+            done
+        fi
+
         if ${CC} -fpic -ferror-limit=1 ${CC_PGLITE} ${PGINC} \
          -o ${BUILD_PATH}/sdk_port-wasi.o \
          -c wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c \
@@ -98,6 +116,7 @@ ________________________________________________________
              -nostartfiles ${PGINC} ${BUILD_PATH}/pglite.o \
              ${BUILD_PATH}/sdk_port-wasi.o \
              $LINKER $LIBPGCORE \
+             $VECTOR_OBJS \
              $LINK_ICU \
              ${PG_BUILD}/${BUILD}/src/backend/snowball/libdict_snowball.a \
              ${PG_BUILD}/${BUILD}/src/pl/plpgsql/src/libplpgsql.a \
diff --git a/pglite-REL_17_4_WASM/interactive_one.c b/pglite-REL_17_4_WASM/interactive_one.c
index fc35909..509cb0a 100644
--- a/pglite-REL_17_4_WASM/interactive_one.c
+++ b/pglite-REL_17_4_WASM/interactive_one.c
@@ -246,6 +246,18 @@ puts("# 243:" __FILE__ );
     if (am_walsender)
         WalSndErrorCleanup();
 
+#if defined(__wasi__)
+    /* Without sigsetjmp the active portal is never unwound, which makes
+     * PortalErrorCleanup() abort with "cannot drop active portal". Replicate
+     * what PortalRunCleanup would have done before dropping the portals. */
+    {
+        extern Portal ActivePortal;
+        if (ActivePortal != NULL)
+            ActivePortal->status = PORTAL_FAILED;
+        ActivePortal = NULL;
+    }
+#endif
+
     PortalErrorCleanup();
     if (MyReplicationSlot != NULL)
         ReplicationSlotRelease();
diff --git a/wasm-build/build-ext.sh b/wasm-build/build-ext.sh
index c8aa99d..82d6496 100755
--- a/wasm-build/build-ext.sh
+++ b/wasm-build/build-ext.sh
@@ -37,9 +37,23 @@ fi
 # common wasi/emsdk contrib build
 if $SKIP_CONTRIB
 then
-    echo "
+    if $WASI
+    then
+        echo "
+    * WASI: building static extra extensions
+        "
+        for wasi_ext in ./extra/*-wasi.sh
+        do
+            [ -f "${wasi_ext}" ] || continue
+            LOG=$PG_DIST_EXT/$(basename ${wasi_ext}).log
+            echo "====  ${wasi_ext} : $LOG ===="
+            ${wasi_ext} > $LOG || exit 113
+        done
+    else
+        echo "
     * skipping contrib build
-    "
+        "
+    fi
     exit 0
 fi
 
