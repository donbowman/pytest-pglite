diff --git a/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c b/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c
index 44dac9e..7563615 100644
--- a/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c
+++ b/wasm-build/sdk_port-wasi/sdk_port-wasi-dlfcn.c
@@ -5,6 +5,12 @@
 
 #include "fmgr.h"
 
+#if defined(__has_include)
+#  if __has_include("vector_symbols.h")
+#    include "vector_symbols.h"
+#  endif
+#endif
+
 typedef struct dict_entry_s {
     const char *key;
     int value;
@@ -81,7 +87,8 @@ ends_with(const char *str, const char *suffix)
 
 // dlfcn.h
 
-volatile dict_t* dltab[];
+#define DLTAB_MAX 64
+volatile dict_t* dltab[DLTAB_MAX];
 volatile int dltab_index = 0;
 
 void *
@@ -126,24 +133,34 @@ extern void plpgsql_validator(void);
 
 extern void _PG_init(void);
 
+extern void pglite_vector_PG_init(void);
+
 
 void *
 dlopen(const char *filename, int flags) {
     dict_t tab = NULL;
     fprintf(stderr,"void *dlopen(const char *filename = %s, int flags=%d)\n", filename, flags);
-    for (int i=0; i< dltab_index; i++) {
-        if ( dict_find_index(dltab[i], filename) > 0 )
-            return (void *)i;
+    for (int i = 0; i < dltab_index; i++) {
+        if (dltab[i] && dict_find_index(dltab[i], filename) >= 0)
+            return (void *)(i + 1);
     }
-    printf("dlopen: new lib '%s'\n", filename );
+    printf("dlopen: new lib '%s'\n", filename);
     if ( ends_with(filename,"/plpgsql.so") ){
         puts(" ========= CALLING _PG_init =========");
         _PG_init();
     }
 
+    if ( ends_with(filename,"/vector.so") ){
+        puts(" ========= CALLING vector _PG_init =========");
+        pglite_vector_PG_init();
+    }
+
+    if (dltab_index >= DLTAB_MAX)
+        return NULL;
     tab = dict_new();
-    dict_add(tab, filename, dltab_index++ );
+    dict_add(tab, filename, dltab_index);
     dltab[dltab_index] = tab;
+    dltab_index++;
 
     return (void *)dltab_index;
 }
@@ -190,6 +207,12 @@ dlsym(void *__restrict handle, const char *__restrict symbol) {
         goto report;
     }
 
+#ifdef PGLITE_STATIC_EXTENSION_SYMBOLS
+    sym = pglite_lookup_extension_symbol(symbol);
+    if (sym)
+        goto report;
+#endif
+
 report:;
     fprintf(stderr, "void *dlsym(void *handle = %p, const char *symbol = %s) => %p\n", handle, symbol, sym);
     return sym;
